# Сценарий: CONSTRUCTION → расстановка блоков → старт уровня.
# Биты: 01=A 02=B 04=Select 08=Start 10=Up 20=Down 40=Left 80=Right
0    00
400  04   # Select: курсор на 2 PLAYERS
404  00
420  04   # Select: курсор на CONSTRUCTION
424  00
440  08   # Start → редактор
444  00
560  01   # A: блок под курсором
564  00
580  01   # A ещё раз — следующий тип блока
584  00
600  80   # вправо
640  01
644  00
660  20   # вниз
700  02   # B: перебор блоков назад
704  00
720  81   # вправо + A (рисование при движении)
800  21   # вниз + A
880  00
900  08   # Start → выход в меню
904  00
1000 04   # Select: CONSTRUCTION → 1 PLAYER
1004 00
1020 08   # Start → STAGE 1 на своей карте
1024 00
1140 08   # Start → бой
1144 00
1300 12   # вверх + огонь
1400 42   # влево + огонь
1500 00
