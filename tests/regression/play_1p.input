# Сценарий: 1 PLAYER → STAGE 1 → бой: движение, стрельба, пауза.
# Формат: <кадр> <P1 hex> [<P2 hex>]; кнопки держатся до следующей строки.
# Биты: 01=A 02=B 04=Select 08=Start 10=Up 20=Down 40=Left 80=Right
0    00
400  08   # Start на титуле (1 PLAYER)
404  00
520  08   # Start на экране STAGE 1
524  00
900  10   # вверх
960  12   # вверх + огонь
1000 10
1040 12
1080 40   # влево
1150 42   # влево + огонь
1200 40
1260 80   # вправо
1400 82
1440 80
1500 20   # вниз
1560 00
1600 08   # пауза
1604 00
1700 08   # снять паузу
1704 00
1760 12
1900 42
2050 82
2200 22
2350 12
2500 00
